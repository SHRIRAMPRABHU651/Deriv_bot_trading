# Non-secret configuration. Copy to config.yaml to override. Secrets live in .env only.
app:
  host: 127.0.0.1
  port: 8000
  db_path: data/derivbot.db
  log_dir: logs
  model_dir: model
  timezone: UTC            # day/week boundaries; weekly boundary = Monday 00:00 in this zone
  allowed_hosts: [127.0.0.1, localhost]
  allowed_origins: ["http://127.0.0.1:8000", "http://localhost:8000"]

deriv:
  rest_base_url: https://api.derivws.com      # UNCONFIRMED against live docs, see docs/API_NOTES.md
  requests_per_second: 5
  burst: 10
  ping_interval_s: 15
  ping_timeout_s: 10
  request_timeout_s: 10
  proposal_timeout_s: 5
  buy_timeout_s: 8
  settlement_timeout_s: 120   # beyond expiry, move to RECONCILIATION_PENDING

trading:
  symbols: [R_100]
  currency: USD
  duration_ticks: 10           # N: contract expiry in ticks == label horizon
  min_stake: "0.35"
  stake_precision: 2
  max_signal_age_s: 2.0
  max_price_slippage_percent: "0"   # buy at most the proposal ask price
  execution_workers: 2
  tick_queue_size: 256
  signal_queue_size: 32

strategy:
  name: ml                     # ml | ema
  version: "1"
  ema_fast: 5
  ema_slow: 20

risk:
  balance_max_age_s: 60
  feed_stale_after_s: 10
  max_latency_ms: 2000          # 0 disables the latency halt
  latency_halt_enabled: false
  correlation_groups:
    volatility_indices: [R_10, R_25, R_50, R_75, R_100]
  demo:
    stake_percent: "0.01"
    stake_cap_percent: "0.01"
    daily_loss_percent: "0.03"
    weekly_loss_percent: "0.06"
    max_drawdown_percent: "0.10"
    max_consecutive_losses: 3
    max_trades_per_day: 200
    max_open_trades: 2
    max_open_trades_per_symbol: 1
    max_total_exposure_percent: "0.03"
    max_group_exposure_percent: "0.02"
    cooldown_seconds: 5
  live:
    stake_percent: "0.005"
    stake_cap_percent: "0.005"
    daily_loss_percent: "0.01"
    weekly_loss_percent: "0.03"
    max_drawdown_percent: "0.10"
    max_consecutive_losses: 3
    max_trades_per_day: 50
    max_open_trades: 1
    max_open_trades_per_symbol: 1
    max_total_exposure_percent: "0.01"
    max_group_exposure_percent: "0.01"
    cooldown_seconds: 10

ml:
  edge_margin: 0.03
  alpha: 0.05
  min_validation_trades: 300      # min out-of-sample trades before a model may be WALK_FORWARD_VALID
  min_demo_trades: 1000           # min demo trades before PROMOTABLE
  monitor_window: 100
  monitor_alpha: 0.05
  feature_version: v1

retention:
  ticks_days: 7
  latency_days: 30
  store_ticks: false
  cleanup_interval_s: 3600
