# Copy to .env and fill in. NEVER commit .env. NEVER paste tokens into chat.
# --- Deriv (current API: Personal Access Token + App ID) ---
DERIV_APP_ID=YOUR_DERIV_APP_ID
DERIV_DEMO_TOKEN=YOUR_DEMO_PAT
DERIV_DEMO_ACCOUNT_ID=YOUR_DEMO_OPTIONS_ACCOUNT_ID

# --- LIVE: leave everything below empty/false unless you have deliberately decided otherwise ---
ALLOW_LIVE=false
DERIV_LIVE_TOKEN=
DERIV_LIVE_ACCOUNT_ID=

# --- Dashboard (leave empty to auto-generate a random token at each start) ---
DASHBOARD_TOKEN=

# --- Optional Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DEMO-only pipeline test (no model needed; NOT a strategy, never runs in LIVE). Or use config.yaml probe.enabled
DEMO_PROBE=false
