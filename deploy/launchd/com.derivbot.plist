<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.derivbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/derivbot/.venv/bin/python</string>
    <string>-m</string>
    <string>app.main</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/derivbot</string>
  <!-- Secrets stay in /Users/YOU/derivbot/.env (read by the app itself). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>AUTOSTART</key>
    <string>false</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOU/derivbot/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/derivbot/logs/launchd.err.log</string>
</dict>
</plist>
